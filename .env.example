# Copy this file to .env.local and put real values there only.
# .env.local is ignored by git. Never commit or paste real keys.

# LiveKit. Leave the YOUR_ values as they are to use Chert rooms through chert dev.
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# The name the agent registers with (a name, not a secret).
AGENT_NAME=renal-dietitian

# Gemini API key.
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY
# Optional Gemini Live model id. Empty means gemini-3.8-live.
GEMINI_LIVE_MODEL=
# Optional Gemini models for renal vision and meal ideas. Empty means the primary gemini-3.8-flash and the fallback gemini-3.5-flash-lite.
# The fallback is used automatically when the primary errors or has not answered within 2.5 s.
RENAL_VISION_MODEL=
RENAL_VISION_FALLBACK_MODEL=
RENAL_MEALS_MODEL=
RENAL_MEALS_FALLBACK_MODEL=
# Optional. Model for the Google Search grounded nutrition lookup, used when a food is not in the seed list or USDA. Empty means gemini-3.5-flash-lite.
# RENAL_LOOKUP_MODEL=
# Optional. Fallback model for that lookup. Empty means no fallback.
# RENAL_LOOKUP_FALLBACK_MODEL=
# Optional. 1 = the camera accepts video from any non-agent participant, for LiveKit playground tests. Leave empty for real calls.
PLAYGROUND=
# Optional. A folder OUTSIDE this repo where each camera picture sent to describeImage is also saved, to check what the agent saw. Empty saves nothing.
AGENT_DEBUG_FRAME_DIR=
# Optional. 1 = the agent shows a built-in magenta test frame as the "cart" (6 s after the session starts, for 6 s), for the simulated proof only. Leave empty for real calls.
AGENT_FAKE_CART=
# Optional. 1 = the caller can interrupt the agent mid-reply (barge-in). Empty keeps replies uninterrupted, which suits a noisy store.
AGENT_ALLOW_BARGE_IN=
# Optional. Milliseconds of silence before the agent treats the caller's turn as finished (300 to 3000). Empty means 1000. Raise it if the agent answers while the caller is still talking.
AGENT_END_SILENCE_MS=
# Optional. Folder OUTSIDE this repo for the shopping list kept between calls (one small file per patient, food names only) and the caller's chosen voice, reply length, language and preferred name. Empty uses a folder in the system temp directory.
AGENT_STATE_DIR=
# Optional. Seconds after the greeting before the agent warns that the call will end soon. Empty means 240.
AGENT_CALL_WARN_SECONDS=
# Optional. 1 = do not start first-call setup by itself ("update my setup" still works). Empty sets up a caller with no finished setup on their first call.
AGENT_SKIP_ONBOARDING=
# Optional. 1 = any phone that has joined the Chert project gets its own profile and can be texted; empty = everyone is the demo patient (default).
AGENT_OPEN_ACCESS=
# Optional. Share of the frame's width and height used by everything shown on the call (centred), so the zoomed FaceTime picture does not cut it off. 0.5 to 1; empty or invalid means 0.8; 1 is the old full-frame layout.
VIDEO_SAFE_SCALE=

# FoodData Central key (DEMO_KEY also works but is rate limited).
USDA_API_KEY=YOUR_USDA_API_KEY

# Optional. Folder where renal keeps its writable diary.json and cache.json (empty uses renal/data) and the patient's saved profiles.json (empty uses a renal-state folder in the system temp directory, never inside the repo). Tests set this to a temp dir.
RENAL_STATE_DIR=

# Chert project API key, project id and line id.
CHERT_API_KEY=YOUR_CHERT_API_KEY
CHERT_PROJECT_ID=YOUR_CHERT_PROJECT_ID
CHERT_LINE_ID=YOUR_CHERT_LINE_ID

# Demo patient phone, international form, verified for the Chert project.
PATIENT_PHONE=YOUR_PATIENT_PHONE

# Track C grocery store and optional Instacart shopping-list fallback.
GROCERY_STORE_URL=
INSTACART_API_KEY=
# Optional Kroger public API cart. Setting both KROGER_CLIENT_ID and KROGER_CLIENT_SECRET switches the cart from the browser to the Kroger API.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
# Kroger store for product search. Empty means 01100695 (Kroger - Ponce).
KROGER_LOCATION_ID=
# Redirect URI for the localhost sign-in, used only when the two relay variables below are empty. Empty means http://localhost:8765/callback. Must match the redirect URI registered on the Kroger app.
KROGER_REDIRECT_URI=
# Kroger sign-in by texted link: the relay's production domain, no trailing slash. See kroger-relay/README.md. With the relay on, the Kroger app's redirect URI is <relay>/api/kroger/callback.
KROGER_RELAY_URL=
# The same value as the relay's RELAY_SECRET, at least 32 characters. See kroger-relay/README.md.
KROGER_RELAY_SECRET=
# Folder OUTSIDE this repo for the Kroger sign-in. Empty means ~/.config/renal-dietitian.
KROGER_TOKEN_DIR=
